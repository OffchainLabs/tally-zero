{
  "$schema": "https://github.com/IBM/audit-ci/raw/main/docs/schema.json",
  // Fail on moderate and above
  "moderate": true,
  "allowlist": [
    // https://github.com/advisories/GHSA-w5hq-g745-h8pq
    // uuid missing buffer bounds check in v3/v5/v6 when caller provides a buf argument.
    // Our transitive consumers (@metamask/sdk, @metamask/utils) only call uuid.v4() without a buf argument, so the unchecked code path is not reached.
    // The fix ships only in 11.1.1, two and three majors past the ^8.3.2 and ^9.0.1 that the MetaMask packages declare.
    // from: @reown/appkit-adapter-wagmi>@wagmi/connectors>@metamask/sdk>uuid (8.3.2)
    // from: @reown/appkit-adapter-wagmi>@wagmi/connectors>@metamask/sdk>@metamask/providers>@metamask/rpc-errors>@metamask/utils>uuid (9.0.1)
    "GHSA-w5hq-g745-h8pq",

    // https://github.com/advisories/GHSA-vcc3-ghjq-m6fr
    // decode-uri-component denial of service via exponential decoding of malformed percent-encoded input.
    // Only reachable through query-string when @walletconnect/utils parses relay/pairing URIs, which runs client-only here (AppKit is never imported by an API route or server module), so malformed input can at worst stall the tab of the user who pasted it.
    // No upgrade path yet: every patched release (>=0.3.0, so also the fixed >=0.5.0) is ESM-only while query-string 7.1.3 is CommonJS and require()s it, so forcing the override throws "decodeComponent is not a function" under Node and under webpack/esbuild bundles. It clears once @wagmi/connectors ships @walletconnect/ethereum-provider >=2.23, whose @walletconnect/utils drops query-string.
    // from: @reown/appkit-adapter-wagmi>@wagmi/connectors>@walletconnect/ethereum-provider>@reown/appkit>@walletconnect/universal-provider>@walletconnect/utils>query-string>decode-uri-component (0.2.2)
    "GHSA-vcc3-ghjq-m6fr",

    // https://github.com/advisories/GHSA-mrhx-c7xc-m3w5
    // zod memory exhaustion: $ZodArray collects an issue object for every failing element of an array schema that has no length constraint, so an oversized array can OOM the process.
    // No fixed release exists on the 3.x line (the fix landed in 4.6.6 only), and zod 4 is a breaking upgrade that @t3-oss/env-nextjs 0.10 and @hookform/resolvers 3 do not support yet.
    // Not reachable here: the only zod parses are env.ts validating NEXT_PUBLIC_* scalars at boot and voteSchema (one string field) through zodResolver in the browser. No API route or server module parses with zod, and proposalSchema's arrays are used for z.infer types plus unit tests only.
    // The transitive 4.x copies (porto, @vercel/cli-config) are pinned to >=4.6.6 by the "zod@4" pnpm override, so only the 3.x copies remain.
    // from: zod (3.25.76)
    // from: @reown/appkit>@reown/appkit-wallet>zod (3.22.4)
    "GHSA-mrhx-c7xc-m3w5",
  ],
}
