{
  "$schema": "https://github.com/IBM/audit-ci/raw/main/docs/schema.json",
  // Fail on moderate and above
  "moderate": true,
  "allowlist": [
    // https://github.com/advisories/GHSA-w5hq-g745-h8pq
    // uuid missing buffer bounds check in v3/v5/v6 when caller provides a buf argument.
    // Our transitive consumers (jayson, @metamask/utils) only call uuid.v4() without a buf argument, so the unchecked code path is not reached.
    // from: @reown/appkit>@reown/appkit-utils>@base-org/account>@coinbase/cdp-sdk>@solana/web3.js>jayson>uuid (8.3.2)
    // from: @reown/appkit-adapter-wagmi>@wagmi/connectors>@metamask/sdk>@metamask/providers>@metamask/rpc-errors>@metamask/utils>uuid (9.0.1)
    "GHSA-w5hq-g745-h8pq",

    // https://github.com/advisories/GHSA-vcc3-ghjq-m6fr
    // decode-uri-component denial of service via exponential decoding of malformed percent-encoded input.
    // Only reachable through query-string when @walletconnect/utils parses relay/pairing URIs, which runs client-only here (AppKit is never imported by an API route or server module), so malformed input can at worst stall the tab of the user who pasted it.
    // No upgrade path yet: every patched release (>=0.3.0, so also the fixed >=0.5.0) is ESM-only while query-string 7.1.3 is CommonJS and require()s it, so forcing the override throws "decodeComponent is not a function" under Node and under webpack/esbuild bundles. It clears once @wagmi/connectors ships @walletconnect/ethereum-provider >=2.23, whose @walletconnect/utils drops query-string.
    // from: @reown/appkit-adapter-wagmi>@wagmi/connectors>@walletconnect/ethereum-provider>@reown/appkit>@walletconnect/universal-provider>@walletconnect/utils>query-string>decode-uri-component (0.2.2)
    "GHSA-vcc3-ghjq-m6fr",

    // https://github.com/advisories/GHSA-528h-pc64-c93x
    // stream-json pick/ignore/filter/replace filters are O(depth^2) on nested input, so a small crafted document can block the event loop.
    // Reason to ignore: the fix ships only in 3.5.0, two majors past the ^1.9.1 that jayson declares. jayson requires only streamers/StreamValues and utils/Verifier, never the affected filters, and the path arrives under the Coinbase adapter inside AppKit, which is client-only here.
    // from: @reown/appkit>@reown/appkit-utils>@base-org/account>@coinbase/cdp-sdk>@solana/web3.js>jayson>stream-json (1.9.1)
    "GHSA-528h-pc64-c93x",

    // https://github.com/advisories/GHSA-hqr4-qq8f-hg3x
    // stream-json JSONC parser and Verifier re-scan the accumulated comment on every chunk, so a long comment causes quadratic CPU use.
    //
    // https://github.com/advisories/GHSA-mjw6-4jj6-33hc
    // stream-json Assembler writes this.current[this.key] without guarding __proto__, allowing prototype pollution from streamed JSON.
    //
    // Reason to ignore: both fixes ship only in 3.6.0, two majors past the ^1.9.1 that jayson declares. jayson reaches stream-json only through utils.parseStream in its TCP/TLS client and server, while @solana/web3.js imports only jayson/lib/client/browser (uuid + generateRequest, no stream-json), and that path is client-only AppKit code here.
    // from: @reown/appkit>@reown/appkit-utils>@base-org/account>@coinbase/cdp-sdk>@solana/web3.js>jayson>stream-json (1.9.1)
    "GHSA-hqr4-qq8f-hg3x",
    "GHSA-mjw6-4jj6-33hc",

    // https://github.com/advisories/GHSA-vfj7-8cjw-p6xm
    // braces stack exhaustion on deeply nested brace patterns.
    // No patched release exists (every version <=3.0.3 is affected). Only reachable through ESLint's fast-glob/micromatch while linting, with glob patterns we author in config, never untrusted input or runtime code.
    // from: eslint-config-next>@next/eslint-plugin-next>fast-glob>micromatch>braces (3.0.3)
    "GHSA-vfj7-8cjw-p6xm",

    // https://github.com/advisories/GHSA-rj75-hqrm-r3gf
    // postcss-selector-parser has quadratic complexity on flat selectors, allowing CPU exhaustion with crafted CSS.
    // Reason to ignore: the fix ships only in 7.1.6 while tailwindcss 3 and @tailwindcss/typography require ^6. The parser runs only at build time over our own stylesheets and Tailwind classes, never on user-supplied CSS.
    // from: tailwindcss>postcss-nested>postcss-selector-parser (6.1.2)
    // from: @tailwindcss/typography>postcss-selector-parser (6.0.10)
    "GHSA-rj75-hqrm-r3gf",
  ],
}
